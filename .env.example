# ---------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha com os valores reais.
# Toda variável NEXT_PUBLIC_* fica visível no navegador. Nunca coloque segredo aqui.
# ---------------------------------------------------------------------------

# Número de WhatsApp em formato internacional, apenas dígitos.
# Exemplo Brasil: 55 (país) + 11 (DDD) + número  =>  5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# (Opcional) Mensagem pré-preenchida no WhatsApp. Se vazio, usa o texto padrão do projeto.
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# (Opcional) URL canônica do site em produção. Usada em SEO, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=https://www.altairdasmilhas.com.br
